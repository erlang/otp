module 'unused_phi' ['unused_phi'/0, 'id'/1]
    attributes []

'f'/2 =
    fun (X, M) ->
        %% Compiled with the `no_ssa_opt` option, this function
        %% would return `P` instead of `R`.
        let <R, P> =
            case X of
              <0> when 'true' -> <M, 'p0'>
              <_> when 'true' -> <X, 'p1'>
            end
        in R

%% unused_phi() ->
%%    a = f(id(a), id(b)),
%%    b = f(id(0), id(b)),
%%    ok.
'unused_phi'/0 =
    ( fun () ->
          let <_1> =
              apply 'id'/1('a')
          in  let <_0> =
                  apply 'id'/1('b')
              in
                  case apply 'f'/2
                           (_1, _0) of
                    <'a'> when 'true' ->
                        let <_4> =
                            apply 'id'/1(0)
                        in  let <_3> =
                                apply 'id'/1('b')
                            in
                                case apply 'f'/2(_4, _3) of
                                  <'b'> when 'true' ->
                                      'ok'
                                  ( <_5> when 'true' ->
                                        primop 'match_fail'
                                            ({'badmatch',_5})
                                    -| ['compiler_generated'] )
                                end
                    ( <_2> when 'true' ->
                          primop 'match_fail'
                              ({'badmatch',_2})
                      -| ['compiler_generated'] )
                  end
      -| [{'function',{'unused_phi',0}}] )

'id'/1 = fun (I) -> I

end
